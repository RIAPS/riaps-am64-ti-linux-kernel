 		>;
 	};

@@ -385,6 +387,22 @@ AM64X_IOPAD(0x00c4, PIN_OUTPUT_PULLUP, 7) /* (V8) GPIO0_48 */
 		>;
 	};

+        mygpio0_pins_default: mygpio0-pin2-default {
+                        pinctrl-single,pins = <
+                                        AM64X_IOPAD(0x00a4, PIN_OUTPUT, 7) /* (N17) GPMC0_DIR.GPIO0_40 */
+                        >;
+        };
+
+        rpi_spi0_pins_default: rpi-spi0-pins-default {
+                pinctrl-single,pins = <
+                        AM64X_IOPAD(0x0210, PIN_OUTPUT, 0) /* D13 SPI0_CLK.SPI0_CLK */
+                        AM64X_IOPAD(0x0208, PIN_OUTPUT, 0) /* D12 SPI0_CS0.SPI0_CS0 */
+                        AM64X_IOPAD(0x020C, PIN_OUTPUT, 0) /* D12 SPI0_CS1.SPI0_CS1 */
+                        AM64X_IOPAD(0x0214, PIN_INPUT, 0)  /* A13 SPI0_D0.SPI0_D0 */
+                        AM64X_IOPAD(0x0218, PIN_OUTPUT, 0) /* A14 SPI0_D1.SPI0_D1 */
+                >;
+        };
+
 	main_com8_ls_en_pins_default: main-com8-ls-en-default-pins {
 		pinctrl-single,pins = <
 			AM64X_IOPAD(0x00fc, PIN_OUTPUT, 7) /* (U7) PRG1_PRU0_GPO17.GPIO0_62 */
@@ -406,6 +424,15 @@ &main_uart0 {
 	current-speed = <115200>;
 };

+&main_gpio0 {
+        pinctrl-names = "default";
+        pinctrl-0 = <&mygpio0_pins_default>;
+
+        gpio0-40 {
+                gpios = <40 GPIO_ACTIVE_HIGH>;
+        };
+};
+
 &main_uart1 {
 	/* main_uart1 is reserved for firmware usage */
 	bootph-pre-ram;
@@ -455,6 +482,23 @@ exp2: gpio@60 {
 	};
 };

+&main_spi0 {
+        status = "okay";
+        pinctrl-names = "default";
+        pinctrl-0 = <&rpi_spi0_pins_default>;
+        ti,spi-num-cs = <2>;
+        spidev@0 {
+                        spi-max-frequency = <1000000>;
+                        reg = <0>;
+                        compatible = "spidev";
+        };
+        spidev@1 {
+                        spi-max-frequency = <1000000>;
+                        reg = <1>;
+                        compatible = "spidev";
+        };
+};
+
 /* mcu_gpio0 and mcu_gpio_intr are reserved for mcu firmware usage */
 &mcu_gpio0 {
 	status = "reserved";
@@ -744,6 +788,8 @@ cpsw_cpts_pps: cpsw-cpts-pps {
 		pinctrl-single,pins = <
 			/* pps [cpts genf1] in22 -> out37 [cpts hw8_push] */
 			TS_OFFSET(37, 22)
+                        /* pps [cpts genf1] in22 -> out24 [SYNC1_OUT pin] */
+                        TS_OFFSET(24, 22)
 			>;
 	};
 };
